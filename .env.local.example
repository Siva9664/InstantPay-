# ──────────────────────────────────────────────────────────────
# InstantPay AI – Environment Variables
# Copy this file to .env.local and fill in your values.
# ──────────────────────────────────────────────────────────────

# ─── OpenAI ───────────────────────────────────────────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-openai-key-here...

# ─── PayPal Sandbox ───────────────────────────────────────────
# 1. Go to https://developer.paypal.com/dashboard/
# 2. Log in (or create a free account)
# 3. Navigate to: Apps & Credentials → Create App (Sandbox)
# 4. Copy the Client ID and Client Secret from the sandbox app
PAYPAL_CLIENT_ID=AYour-Sandbox-Client-ID-Here
PAYPAL_CLIENT_SECRET=EYour-Sandbox-Client-Secret-Here

# ─── PayPal Sandbox Receiver ──────────────────────────────────
# This is the PayPal sandbox email that will RECEIVE the money
# Go to: https://developer.paypal.com/dashboard/accounts
# Use one of the auto-generated sandbox personal accounts
PAYPAL_SANDBOX_RECEIVER_EMAIL=sb-xxxxx@personal.example.com
